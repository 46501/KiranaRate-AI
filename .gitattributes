# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code and templates
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.example text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.db binary
*.sqlite binary
*.sqlite3 binary
*.jpg binary
*.jpeg binary
*.png binary
