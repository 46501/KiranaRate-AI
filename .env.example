# ============================================================
# AI Bill Scanner — Environment Variables Reference
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# WhatsApp Cloud API
# ----------------------------------------------------------

# Token used to verify the webhook subscription with Meta (hub.verify_token)
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token_here

# Meta App Secret from App Dashboard (Settings > Basic) to verify X-Hub-Signature-256 HMAC on inbound POST webhooks
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Long-lived access token from Meta App Dashboard (System User token with whatsapp_business_messaging scope)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Phone Number ID from Meta for Developers WhatsApp product (not the display phone number)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# WhatsApp Cloud API version (default: v19.0)
WHATSAPP_API_VERSION=v19.0

# The WhatsApp number that owns the store account (receives alert messages), E.164 format (e.g. 919876543210)
# Alias WHATSAPP_ALERT_RECIPIENT is also supported.
WHATSAPP_OWNER_NUMBER=919876543210
# WHATSAPP_ALERT_RECIPIENT=919876543210

# Comma-separated list of sender phone numbers allowed to submit bills, E.164 format without '+'
# Alias WHATSAPP_ALLOWED_SENDERS is also supported.
WHATSAPP_ALLOWLIST=919876543210,919123456789
# WHATSAPP_ALLOWED_SENDERS=919876543210,919123456789

# Name of the pre-approved WhatsApp message template for price alerts (default: purchase_rate_review)
WHATSAPP_TEMPLATE_NAME=purchase_rate_review

# Language code for the message template (default: en)
WHATSAPP_TEMPLATE_LANG=en

# ----------------------------------------------------------
# Dashboard & REST API Authentication (Priority 2 Security)
# ----------------------------------------------------------

# Admin username for reviewer dashboard access (default: admin)
DASHBOARD_USERNAME=admin

# Password for reviewer dashboard login (plain text or PBKDF2-SHA256 hash)
DASHBOARD_PASSWORD=your_secure_dashboard_password_here

# Secret key used to sign session cookies (e.g. 32-byte hex string)
SESSION_SECRET_KEY=your_random_32_byte_session_secret_here

# Enforce HTTPS-only session cookies in production (default: false for localhost)
SESSION_COOKIE_SECURE=false

# Secret API Key for REST API endpoints and accounting exports (Bearer or X-API-Key header)
API_KEY=your_secret_api_key_here

# ----------------------------------------------------------
# Rate Limiting & Protection (Priority 3 Security)
# ----------------------------------------------------------

# Enable or disable sliding-window rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Max login requests per minute per IP (default: 10)
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Max bill uploads per minute per IP (default: 20)
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# Max WhatsApp webhook intake requests per minute per IP (default: 120)
RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# Max worker triggers per minute per IP (default: 30)
RATE_LIMIT_WORKER_PER_MINUTE=30

# Max failed login attempts before temporary account lockout (default: 5)
LOGIN_MAX_FAILED_ATTEMPTS=5

# Temporary account lockout duration in seconds after max failed attempts (default: 300)
LOGIN_LOCKOUT_SECONDS=300

# ----------------------------------------------------------
# Google Gemini Vision AI (Live Bill OCR & Extraction)
# ----------------------------------------------------------

# Gemini API key obtained from Google AI Studio (https://aistudio.google.com/)
# 1. Sign in to https://aistudio.google.com/
# 2. Click "Get API key" -> "Create API key"
# 3. Paste the key below in your local .env file (DO NOT commit or share)
# 4. Set MOCK_GEMINI=false below to activate live Gemini Vision extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini vision model identifier used for bill image scanning:
# - gemini-3.8-flash (current default: multimodal vision & structured extraction)
# - gemini-3.5-flash-lite (high-throughput, lightweight document parsing)
GEMINI_MODEL=gemini-3.8-flash

# HTTP request timeout in seconds for Gemini vision API calls (default: 30)
GEMINI_REQUEST_TIMEOUT=30

# ----------------------------------------------------------
# Storage Backend
# ----------------------------------------------------------

# Storage backend: sqlite or sheets (default: sqlite)
STORAGE_BACKEND=sqlite

# Path to the SQLite database file (used when STORAGE_BACKEND=sqlite)
SQLITE_DB_PATH=./bills.db

# ----------------------------------------------------------
# Development, Testing Mocks & Safe Dry-Run Mode
# ----------------------------------------------------------

# Set to true to skip real WhatsApp Graph API calls and log in-memory instead (default: false)
MOCK_WHATSAPP=false

# Set to true to skip real Gemini API calls and return structured fixture data (default: false)
MOCK_GEMINI=false

# Dry-run mode: logs external network calls without dispatching mutations (default: false)
DRY_RUN=false

# ----------------------------------------------------------
# Localisation
# ----------------------------------------------------------

# IANA timezone name for IST business-rule calculations (default: Asia/Kolkata)
TZ_NAME=Asia/Kolkata

# ----------------------------------------------------------
# Bill / Media Constraints
# ----------------------------------------------------------

# Maximum allowed bill image size in megabytes before rejection (default: 5)
BILL_SIZE_LIMIT_MB=5

# Maximum number of line items Gemini may return per bill (default: 75)
MAX_LINES=75

# Minimum number of line items required per bill (default: 1)
MIN_LINES=1

# Directory on disk where downloaded media files are stored (default: ./media)
MEDIA_STORAGE_DIR=./media

# ----------------------------------------------------------
# Alert / Price-Comparison Business Rules
# ----------------------------------------------------------

# Hours after which an unsent PENDING alert transitions to EXPIRED (default: 24)
ALERT_EXPIRY_HOURS=24

# How many days back to look for historical EX_GST purchases when comparing rates (default: 30)
ALERT_LOOKBACK_DAYS=30

# Only bills whose invoice_date is within this many days of today (IST) are eligible for alerts (default: 7)
ALERT_NEW_BILL_DAYS=7

# Minimum price gap percentage to trigger an alert (default: 2.00)
# gap_pct = 100 * (high_rate - low_rate) / high_rate
ALERT_MIN_GAP_PCT=2.00

# Minimum absolute price difference in integer paise to trigger an alert (default: 1)
ALERT_MIN_GAP_PAISE=1

# ----------------------------------------------------------
# Background Scheduler (APScheduler)
# ----------------------------------------------------------

# Enable autonomous background polling loops (default: false)
ENABLE_BACKGROUND_WORKERS=false

# Polling interval in seconds for AI scan worker (default: 15)
WORKER_SCAN_INTERVAL_SECONDS=15

# Polling interval in seconds for purchase post & comparison worker (default: 15)
WORKER_POST_INTERVAL_SECONDS=15

# Polling interval in seconds for WhatsApp alert outbox worker (default: 30)
WORKER_ALERT_INTERVAL_SECONDS=30
